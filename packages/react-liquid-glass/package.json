{
  "name": "@aliajafari/react-liquid-glass",
  "version": "0.1.0",
  "description": "React components for a WebGL2 liquid glass effect (blur, lens distortion, chromatic aberration, frost) with a CSS fallback.",
  "keywords": [
    "react",
    "liquid-glass",
    "glassmorphism",
    "webgl",
    "webgl2",
    "glsl",
    "shader",
    "blur",
    "component"
  ],
  "license": "MIT",
  "author": "Ali A. Jafari",
  "homepage": "https://github.com/aliajafari/Liquid-Glass-with-WebGL/tree/main/packages/react-liquid-glass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliajafari/Liquid-Glass-with-WebGL.git",
    "directory": "packages/react-liquid-glass"
  },
  "bugs": "https://github.com/aliajafari/Liquid-Glass-with-WebGL/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite example",
    "build:example": "vite build example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
